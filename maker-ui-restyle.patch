+    Rect inner = {r.l + in, r.b + in, r.r - in, r.t - in};
+    for (; fill > 0; fill -= 1)
+        mkSprite(MKART_SHADE, "", inner, minf(fill, 1));
+    mkNine(MKART_DARK_PANEL, "", r, 8, 8, scale);
